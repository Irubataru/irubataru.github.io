---
export interface Props {
  href?: string
}

const { href } = Astro.props;
---

<div class="cv-header-tag">
  {href ? (
    <a href={href}>
      <slot />
    </a>
  ) : (
    <slot />
  )}
</div>

<style>
  .cv-header-tag {
    font-family: var(--font-family-sans);
    font-size: 0.9em;
    font-weight: 600;
    color: var(--text-secondary);
    background: rgba(84, 142, 155, 0.1);
    padding: 0.3em 0.8em;
    border-radius: 20px;
    white-space: nowrap;

    a {
      color: inherit;
      text-decoration: none;
    }
  }

  @media (max-width: 768px) {
    .cv-header-tag {
      align-self: flex-start;
    }
  }
</style>
